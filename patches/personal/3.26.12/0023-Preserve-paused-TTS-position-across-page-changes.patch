From: popyoung <popyoung@163.com>
Date: Sun, 28 Jun 2026 17:26:05 +0800
Subject: [PATCH] Preserve paused TTS position across page changes

---
 .github/workflows/ci.yml                      |  2 +-
 .../app/model/ReadAloudPageChangePolicy.kt    | 14 +++++++++
 .../main/java/io/legado/app/model/ReadBook.kt |  8 ++++-
 .../model/ReadAloudPageChangePolicyTest.kt    | 31 +++++++++++++++++++
 4 files changed, 53 insertions(+), 2 deletions(-)
 create mode 100644 app/src/main/java/io/legado/app/model/ReadAloudPageChangePolicy.kt
 create mode 100644 app/src/test/java/io/legado/app/model/ReadAloudPageChangePolicyTest.kt

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 1a57e6a1d..d6ac4fd01 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -41,7 +41,7 @@ jobs:
         run: ./gradlew --no-configuration-cache :app:compileAppDebugKotlin
 
       - name: Test read aloud behavior
-        run: ./gradlew --no-configuration-cache :app:testAppDebugUnitTest --tests "io.legado.app.ui.book.read.page.ReadAloudParagraphHighlighterTest" --tests "io.legado.app.ui.book.read.page.ReadAloudVisualPositionerTest" --tests "io.legado.app.service.ReadAloudProgressTest"
+        run: ./gradlew --no-configuration-cache :app:testAppDebugUnitTest --tests "io.legado.app.ui.book.read.page.ReadAloudParagraphHighlighterTest" --tests "io.legado.app.ui.book.read.page.ReadAloudVisualPositionerTest" --tests "io.legado.app.service.ReadAloudProgressTest" --tests "io.legado.app.model.ReadAloudPageChangePolicyTest"
 
       - name: Build arm64-v8a noR8 APK
         run: ./gradlew --no-configuration-cache -Plegado.splitAbis=arm64-v8a :app:assembleAppNoR8
diff --git a/app/src/main/java/io/legado/app/model/ReadAloudPageChangePolicy.kt b/app/src/main/java/io/legado/app/model/ReadAloudPageChangePolicy.kt
new file mode 100644
index 000000000..932b9bb46
--- /dev/null
+++ b/app/src/main/java/io/legado/app/model/ReadAloudPageChangePolicy.kt
@@ -0,0 +1,14 @@
+package io.legado.app.model
+
+internal object ReadAloudPageChangePolicy {
+
+    @Suppress("UNUSED_PARAMETER")
+    fun shouldRestartPausedServiceFromVisualPage(
+        readAloudRunning: Boolean,
+        readAloudPaused: Boolean,
+        visualChapterCompleted: Boolean,
+        visualChapterChanged: Boolean
+    ): Boolean {
+        return false
+    }
+}
diff --git a/app/src/main/java/io/legado/app/model/ReadBook.kt b/app/src/main/java/io/legado/app/model/ReadBook.kt
index af17ec139..311c1624d 100644
--- a/app/src/main/java/io/legado/app/model/ReadBook.kt
+++ b/app/src/main/java/io/legado/app/model/ReadBook.kt
@@ -644,7 +644,13 @@ object ReadBook : CoroutineScope by MainScope(), KoinComponent {
         val fromReadAloud = readAloudPageChangeDepth > 0
         callBack?.pageChanged(fromReadAloud)
         curTextChapter?.let {
-            if (BaseReadAloudService.isRun && BaseReadAloudService.pause && it.isCompleted) {
+            if (ReadAloudPageChangePolicy.shouldRestartPausedServiceFromVisualPage(
+                    readAloudRunning = BaseReadAloudService.isRun,
+                    readAloudPaused = BaseReadAloudService.pause,
+                    visualChapterCompleted = it.isCompleted,
+                    visualChapterChanged = it.chapter.index != BaseReadAloudService.readAloudChapterIndex
+                )
+            ) {
                 val scrollPageAnim = pageAnim() == 3
                 if (scrollPageAnim && pageChanged) {
                     ReadAloud.pause(appCtx)
diff --git a/app/src/test/java/io/legado/app/model/ReadAloudPageChangePolicyTest.kt b/app/src/test/java/io/legado/app/model/ReadAloudPageChangePolicyTest.kt
new file mode 100644
index 000000000..adba7cc77
--- /dev/null
+++ b/app/src/test/java/io/legado/app/model/ReadAloudPageChangePolicyTest.kt
@@ -0,0 +1,31 @@
+package io.legado.app.model
+
+import org.junit.Assert.assertFalse
+import org.junit.Test
+
+class ReadAloudPageChangePolicyTest {
+
+    @Test
+    fun pausedPageChangeDoesNotRestartReadAloudFromVisualPage() {
+        val shouldRestart = ReadAloudPageChangePolicy.shouldRestartPausedServiceFromVisualPage(
+            readAloudRunning = true,
+            readAloudPaused = true,
+            visualChapterCompleted = true,
+            visualChapterChanged = false
+        )
+
+        assertFalse(shouldRestart)
+    }
+
+    @Test
+    fun pausedCrossChapterPageChangeDoesNotRestartReadAloudFromVisualPage() {
+        val shouldRestart = ReadAloudPageChangePolicy.shouldRestartPausedServiceFromVisualPage(
+            readAloudRunning = true,
+            readAloudPaused = true,
+            visualChapterCompleted = true,
+            visualChapterChanged = true
+        )
+
+        assertFalse(shouldRestart)
+    }
+}

