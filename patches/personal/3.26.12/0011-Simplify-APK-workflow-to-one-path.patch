From 5716e40d414a0c2cfb397cad20ce18ba0ce1fa95 Mon Sep 17 00:00:00 2001
From: popyoung <popyoung@163.com>
Date: Sat, 27 Jun 2026 15:11:34 +0800
Subject: [PATCH 11/15] Simplify APK workflow to one path

---
 .github/workflows/ci.yml | 29 ++++-------------------------
 1 file changed, 4 insertions(+), 25 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 3c2d0cf2e..1191558bd 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -1,4 +1,4 @@
-name: CI
+name: Build APK
 
 on:
   pull_request:
@@ -6,15 +6,6 @@ on:
       - "personal/**"
       - "custom/**"
   workflow_dispatch:
-    inputs:
-      build_variant:
-        description: "Manual task"
-        required: true
-        default: "arm64-v8a-noR8"
-        type: choice
-        options:
-          - arm64-v8a-noR8
-          - check
 
 jobs:
   android:
@@ -47,30 +38,18 @@ jobs:
         run: sed -i '/maven.aliyun.com/d' settings.gradle
 
       - name: Compile app debug Kotlin
-        if: github.event_name != 'workflow_dispatch' || inputs.build_variant == 'check'
         run: ./gradlew --no-configuration-cache :app:compileAppDebugKotlin
 
       - name: Test read aloud visual behavior
         run: ./gradlew --no-configuration-cache :app:testAppDebugUnitTest --tests "io.legado.app.ui.book.read.page.ReadAloudParagraphHighlighterTest" --tests "io.legado.app.ui.book.read.page.ReadAloudVisualPositionerTest"
 
-      - name: Build selected APK
-        if: github.event_name == 'workflow_dispatch' && inputs.build_variant != 'check'
-        run: |
-          case "${{ inputs.build_variant }}" in
-            arm64-v8a-noR8)
-              ./gradlew --no-configuration-cache -Plegado.splitAbis=arm64-v8a :app:assembleAppNoR8
-              ;;
-            *)
-              echo "Unknown build_variant: ${{ inputs.build_variant }}"
-              exit 1
-              ;;
-          esac
+      - name: Build arm64-v8a noR8 APK
+        run: ./gradlew --no-configuration-cache -Plegado.splitAbis=arm64-v8a :app:assembleAppNoR8
 
       - name: Upload APKs
-        if: github.event_name == 'workflow_dispatch' && inputs.build_variant != 'check'
         uses: actions/upload-artifact@v4
         with:
-          name: legado-${{ inputs.build_variant }}-unsigned-apk
+          name: legado-arm64-v8a-noR8-unsigned-apk
           path: app/build/outputs/apk/**/noR8/*arm64-v8a*.apk
           if-no-files-found: error
           retention-days: 14
-- 
2.33.0.windows.2

