From d2b8d488b1248ebb9c37f12ba0b5e72d0e5a602b Mon Sep 17 00:00:00 2001
From: popyoung <popyoung@163.com>
Date: Wed, 8 Jul 2026 11:10:56 +0800
Subject: [PATCH] Defer TTS manual page sync in scroll mode

---
 .../app/service/BaseReadAloudService.kt       | 11 ++++++-
 .../read/page/ReadAloudVisualPositioner.kt    |  7 +++++
 .../page/ReadAloudVisualPositionerTest.kt     | 30 +++++++++++++++++++
 3 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/io/legado/app/service/BaseReadAloudService.kt b/app/src/main/java/io/legado/app/service/BaseReadAloudService.kt
index 9c5011b1c..afbbf80b4 100644
--- a/app/src/main/java/io/legado/app/service/BaseReadAloudService.kt
+++ b/app/src/main/java/io/legado/app/service/BaseReadAloudService.kt
@@ -45,6 +45,7 @@ import io.legado.app.model.ReadAloudPageChangePolicy
 import io.legado.app.model.ReadBook
 import io.legado.app.receiver.MediaButtonReceiver
 import io.legado.app.ui.book.read.ReadBookActivity
+import io.legado.app.ui.book.read.page.ReadAloudVisualPositioner
 import io.legado.app.ui.book.read.page.entities.TextChapter
 import io.legado.app.utils.LogUtils
 import io.legado.app.utils.activityPendingIntent
@@ -445,10 +446,18 @@ abstract class BaseReadAloudService : BaseService(),
 
     private fun syncReadBookPageToReadAloudPosition(textChapter: TextChapter) {
         val targetPageIndex = textChapter.getPageIndexByCharIndex(readAloudNumber)
-        if (targetPageIndex < 0 || targetPageIndex == pageIndex) {
+        if (targetPageIndex < 0) {
             return
         }
+        val targetPageChanged = targetPageIndex != pageIndex
         pageIndex = targetPageIndex
+        if (!ReadAloudVisualPositioner.shouldSyncReadBookPageBeforeManualStepProgress(
+                scrollPageAnim = ReadBook.pageAnim() == 3,
+                targetPageChanged = targetPageChanged
+            )
+        ) {
+            return
+        }
         ReadBook.withReadAloudPageChange {
             ReadBook.skipToPage(pageIndex, chapterPos = readAloudNumber)
         }
diff --git a/app/src/main/java/io/legado/app/ui/book/read/page/ReadAloudVisualPositioner.kt b/app/src/main/java/io/legado/app/ui/book/read/page/ReadAloudVisualPositioner.kt
index abcc0511e..3fa60826d 100644
--- a/app/src/main/java/io/legado/app/ui/book/read/page/ReadAloudVisualPositioner.kt
+++ b/app/src/main/java/io/legado/app/ui/book/read/page/ReadAloudVisualPositioner.kt
@@ -188,6 +188,13 @@ internal object ReadAloudVisualPositioner {
         return explicitFollowRestore || !readAloudVisualFollowPaused
     }
 
+    fun shouldSyncReadBookPageBeforeManualStepProgress(
+        scrollPageAnim: Boolean,
+        targetPageChanged: Boolean
+    ): Boolean {
+        return targetPageChanged && !scrollPageAnim
+    }
+
     fun clearFollowState(state: FollowState): FollowState {
         return state.copy(readAloudOffset = 0, active = false)
     }
diff --git a/app/src/test/java/io/legado/app/ui/book/read/page/ReadAloudVisualPositionerTest.kt b/app/src/test/java/io/legado/app/ui/book/read/page/ReadAloudVisualPositionerTest.kt
index 2765e2c6d..e388ae99c 100644
--- a/app/src/test/java/io/legado/app/ui/book/read/page/ReadAloudVisualPositionerTest.kt
+++ b/app/src/test/java/io/legado/app/ui/book/read/page/ReadAloudVisualPositionerTest.kt
@@ -473,6 +473,36 @@ class ReadAloudVisualPositionerTest {
         assertTrue(shouldFollow)
     }
 
+    @Test
+    fun scrollModeDefersReadBookPageSyncBeforeManualStepProgress() {
+        val shouldSync = ReadAloudVisualPositioner.shouldSyncReadBookPageBeforeManualStepProgress(
+            scrollPageAnim = true,
+            targetPageChanged = true
+        )
+
+        assertFalse(shouldSync)
+    }
+
+    @Test
+    fun nonScrollModeKeepsReadBookPageSyncBeforeManualStepProgress() {
+        val shouldSync = ReadAloudVisualPositioner.shouldSyncReadBookPageBeforeManualStepProgress(
+            scrollPageAnim = false,
+            targetPageChanged = true
+        )
+
+        assertTrue(shouldSync)
+    }
+
+    @Test
+    fun unchangedTargetPageDoesNotNeedReadBookPageSyncBeforeManualStepProgress() {
+        val shouldSync = ReadAloudVisualPositioner.shouldSyncReadBookPageBeforeManualStepProgress(
+            scrollPageAnim = false,
+            targetPageChanged = false
+        )
+
+        assertFalse(shouldSync)
+    }
+
     @Test
     fun clearFollowStateKeepsScrollOffset() {
         val state = ReadAloudVisualPositioner.clearFollowState(

