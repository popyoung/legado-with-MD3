Subject: [PATCH 04/15] Add read aloud tests to APK build [skip ci]

---
 .github/workflows/ci.yml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 95a8eb0e7..41e0b15b4 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -87,6 +87,9 @@ jobs:
       - name: Remove Aliyun mirrors
         run: sed -i '/maven.aliyun.com/d' settings.gradle
 
+      - name: Test read aloud visual behavior
+        run: ./gradlew --no-configuration-cache :app:testAppDebugUnitTest --tests "io.legado.app.ui.book.read.page.ReadAloudParagraphHighlighterTest" --tests "io.legado.app.ui.book.read.page.ReadAloudVisualPositionerTest"
+
       - name: Build selected APK
         run: |
           case "${{ inputs.build_variant }}" in
