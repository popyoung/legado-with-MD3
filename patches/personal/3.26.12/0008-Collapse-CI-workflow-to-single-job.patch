From 2bd3f807547637e11b2a71e096d16e2401414421 Mon Sep 17 00:00:00 2001
From: popyoung <popyoung@163.com>
Date: Sat, 27 Jun 2026 13:57:54 +0800
Subject: [PATCH 08/15] Collapse CI workflow to single job

---
 .github/workflows/ci.yml | 41 +++++-----------------------------------
 1 file changed, 5 insertions(+), 36 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 81148ba44..3c2d0cf2e 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -17,10 +17,9 @@ on:
           - check
 
 jobs:
-  compile:
-    name: Compile Kotlin
+  android:
+    name: Android
     runs-on: ubuntu-latest
-    if: github.event_name != 'workflow_dispatch' || inputs.build_variant == 'check'
 
     steps:
       - name: Checkout
@@ -48,45 +47,14 @@ jobs:
         run: sed -i '/maven.aliyun.com/d' settings.gradle
 
       - name: Compile app debug Kotlin
+        if: github.event_name != 'workflow_dispatch' || inputs.build_variant == 'check'
         run: ./gradlew --no-configuration-cache :app:compileAppDebugKotlin
 
       - name: Test read aloud visual behavior
         run: ./gradlew --no-configuration-cache :app:testAppDebugUnitTest --tests "io.legado.app.ui.book.read.page.ReadAloudParagraphHighlighterTest" --tests "io.legado.app.ui.book.read.page.ReadAloudVisualPositionerTest"
 
-  build-apk:
-    name: Build ${{ inputs.build_variant }} APK
-    runs-on: ubuntu-latest
-    if: github.event_name == 'workflow_dispatch' && inputs.build_variant != 'check'
-
-    steps:
-      - name: Checkout
-        uses: actions/checkout@v4
-
-      - name: Set up JDK 21
-        uses: actions/setup-java@v4
-        with:
-          distribution: temurin
-          java-version: "21"
-
-      - name: Set up Android SDK
-        uses: android-actions/setup-android@v3
-
-      - name: Install Android SDK packages
-        run: sdkmanager "platforms;android-37.0" "build-tools;37.0.0"
-
-      - name: Set up Gradle
-        uses: gradle/actions/setup-gradle@v4
-
-      - name: Make Gradle wrapper executable
-        run: chmod +x ./gradlew
-
-      - name: Remove Aliyun mirrors
-        run: sed -i '/maven.aliyun.com/d' settings.gradle
-
-      - name: Test read aloud visual behavior
-        run: ./gradlew --no-configuration-cache :app:testAppDebugUnitTest --tests "io.legado.app.ui.book.read.page.ReadAloudParagraphHighlighterTest" --tests "io.legado.app.ui.book.read.page.ReadAloudVisualPositionerTest"
-
       - name: Build selected APK
+        if: github.event_name == 'workflow_dispatch' && inputs.build_variant != 'check'
         run: |
           case "${{ inputs.build_variant }}" in
             arm64-v8a-noR8)
@@ -99,6 +67,7 @@ jobs:
           esac
 
       - name: Upload APKs
+        if: github.event_name == 'workflow_dispatch' && inputs.build_variant != 'check'
         uses: actions/upload-artifact@v4
         with:
           name: legado-${{ inputs.build_variant }}-unsigned-apk
-- 
2.33.0.windows.2

