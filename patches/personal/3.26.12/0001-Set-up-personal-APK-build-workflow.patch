index 000000000..2633026c8
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,81 @@
+name: Build APK
+
+on:
+  pull_request:
+    branches:
+      - "personal/**"
+      - "custom/**"
+  workflow_dispatch:
+
+jobs:
+  android:
+    name: Android
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 21
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "21"
+
+      - name: Set up Android SDK
+        uses: android-actions/setup-android@v3
+
+      - name: Install Android SDK packages
+        run: sdkmanager "platforms;android-37.0" "build-tools;37.0.0"
+
+      - name: Set up Gradle
+        uses: gradle/actions/setup-gradle@v4
+
+      - name: Make Gradle wrapper executable
+        run: chmod +x ./gradlew
+
+      - name: Remove Aliyun mirrors
+        run: sed -i '/maven.aliyun.com/d' settings.gradle
+
+      - name: Compile app debug Kotlin
+        run: ./gradlew --no-configuration-cache :app:compileAppDebugKotlin
+
+      - name: Test read aloud behavior
+        run: ./gradlew --no-configuration-cache :app:testAppDebugUnitTest --tests "io.legado.app.ui.book.read.page.ReadAloudParagraphHighlighterTest" --tests "io.legado.app.ui.book.read.page.ReadAloudVisualPositionerTest" --tests "io.legado.app.service.ReadAloudProgressTest" --tests "io.legado.app.model.ReadAloudPageChangePolicyTest"
+
+      - name: Build arm64-v8a noR8 APK
+        run: ./gradlew --no-configuration-cache -Plegado.splitAbis=arm64-v8a :app:assembleAppNoR8
+
+      - name: Prepare versioned APK artifact
+        id: apk_artifact
+        shell: bash
+        run: |
+          set -euo pipefail
+          source app/version.properties
+
+          version_name="${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_PATCH}"
+          if [[ -n "${VERSION_PERSONAL:-}" && "${VERSION_PERSONAL}" != "0" ]]; then
+            version_name="${version_name}.${VERSION_PERSONAL}"
+          fi
+          version_name="${version_name}-noR8"
+
+          artifact_name="legado-${version_name}-arm64-v8a-unsigned-apk"
+          apk_name="legado-${version_name}-arm64-v8a-unsigned.apk"
+          output_dir="app/build/outputs/apk/versioned"
+          apk_path="$(find app/build/outputs/apk -path '*/noR8/*arm64-v8a*.apk' -type f -print -quit)"
+          if [[ -z "$apk_path" ]]; then
+            echo "No arm64-v8a noR8 APK found" >&2
+            exit 1
+          fi
+
+          mkdir -p "$output_dir"
+          cp "$apk_path" "$output_dir/$apk_name"
+          echo "artifact_name=$artifact_name" >> "$GITHUB_OUTPUT"
+
+      - name: Upload APKs
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ steps.apk_artifact.outputs.artifact_name }}
+          path: app/build/outputs/apk/versioned/*.apk
+          if-no-files-found: error
+          retention-days: 14
